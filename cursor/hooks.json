{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "~/.cursor/hooks/cursor_audit.sh" },
      { "command": "~/.cursor/hooks/tmux-agent-state.sh" }
    ],
    "beforeShellExecution": [{ "command": "~/.cursor/hooks/cursor_audit.sh" }],
    "afterShellExecution": [{ "command": "~/.cursor/hooks/cursor_audit.sh" }],
    "stop": [
      { "command": "~/.cursor/hooks/tmux-agent-state.sh" }
    ]
  }
}
